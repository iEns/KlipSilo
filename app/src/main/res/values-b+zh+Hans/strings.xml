    <string name="tip_clips_auto_t">保存剪贴板</string>
    <string name="tip_clips_auto_b">点一下即可把当前剪贴板存为剪贴；其他内容通过分享 → KlipSilo 进入。</string>
    <string name="tip_clips_search_t">搜索和筛选</string>
    <string name="tip_clips_search_b">用搜索框和类型筛选快速找到剪贴。</string>
    <string name="tip_clips_tap_t">双击图标</string>
    <string name="tip_clips_tap_b">双击 URL 图标在浏览器中打开，或双击位置图标打开导航。</string>
    <string name="tip_clips_rename_t">重命名</string>
    <string name="tip_clips_rename_b">在操作面板中重命名（位置除外）。已锁定的剪贴也不能重命名。</string>
    <string name="tip_clips_duplicate_t">复制副本</string>
    <string name="tip_clips_duplicate_b">复制一条剪贴即可得到内容相同的新剪贴，文件也会被复制。</string>
    <string name="tip_clips_pin_t">置顶剪贴</string>
    <string name="tip_clips_pin_b">点按图钉可让重要剪贴留在列表顶部。再点一次即可取消。</string>
    <string name="tip_clips_lock_t">锁定剪贴</string>
    <string name="tip_clips_lock_b">在操作面板中选择「锁定/解锁」以保护剪贴。已锁定的剪贴在图钉旁显示锁，不能删除、重命名或编辑，维护里的删除也会跳过它。其他功能仍可用：查看内容、分享、转换和复制副本。在同一处解锁。</string>
    <string name="tip_clips_delete_t">删除并可撤消</string>
    <string name="tip_clips_delete_b">删除剪贴时可撤消；在维护中也可以按类型整批删除。已锁定的剪贴不会被删除。</string>
    <string name="tip_sheet_open_t">打开剪贴</string>
    <string name="tip_sheet_open_b">点按剪贴即可打开。长按剪贴或点按 ⋮ 可打开操作面板：查看内容、分享、保存到下载、转换、重命名、复制副本、锁定/解锁和删除。已锁定的剪贴上，重命名、删除和编辑会变灰。</string>
    <string name="tip_sheet_links_t">查找链接和号码</string>
    <string name="tip_sheet_links_b">在文本和 PDF 剪贴中可以找出 URL 和电话号码，然后打开或拨打。</string>
    <string name="tip_sheet_convert_t">转换文件</string>
    <string name="tip_sheet_convert_b">文件剪贴可以转为 PDF 或纯文本（txt、rtf、docx、xlsx）。未知格式可以尝试作为文本打开，docx、xlsx 和 rtf 会直接显示为可读文本。</string>
    <string name="tip_pdf_zoom_t">缩放和平移</string>
    <string name="tip_pdf_zoom_b">双指缩放，放大后可以平移。页面从 1 倍开始。</string>
    <string name="tip_pdf_pages_t">浏览页面</string>
    <string name="tip_pdf_pages_b">用箭头翻页，把单页另存为独立 PDF，或把该页图片提取为新的图片剪贴。</string>
    <string name="tip_pdf_qr_t">页面中的二维码</string>
    <string name="tip_pdf_qr_b">二维码按钮读取页面上的码：可以复制内容、存为剪贴，或直接在文本编辑器中打开。</string>
    <string name="tip_pdf_ocr_t">OCR</string>
    <string name="tip_pdf_ocr_b">对当前页或整个 PDF 做 OCR 以提取文本。</string>
    <string name="tip_tools_text_t">创建文本</string>
    <string name="tip_tools_text_b">创建文本剪贴后会直接进入编辑器，用对勾保存。编辑器有撤消/重做、可调字号（A−/A+）和自己的 PDF 按钮。</string>
    <string name="tip_tools_pos_t">创建位置</string>
    <string name="tip_tools_pos_b">用你的当前地址创建一条剪贴。应用会在请求定位前说明原因，你也可以拒绝，其余功能照常使用。</string>
    <string name="tip_tools_combine_t">合并</string>
    <string name="tip_tools_combine_b">合并 PDF 或文本剪贴，并用数字标出顺序。</string>
    <string name="tip_tools_annotate_t">向 PDF 添加文本和笔迹</string>
    <string name="tip_tools_annotate_b">添加文本，画直线或自由笔迹，并从顶栏保存一份新 PDF。</string>
    <string name="tip_tools_maintenance_t">维护</string>
    <string name="tip_tools_maintenance_b">按类型删除剪贴，或全部删除，并且可以撤消。已锁定的剪贴不计入也不删除。通过「备份剪贴」把全部剪贴存成 zip，并自行选择位置（例如 Google Drive）。文件名包含日期。「恢复剪贴」会载入一个或多个以前保存的 zip：新剪贴被追加，不会覆盖，置顶、锁定和时间都会保留。</string>
    <string name="tip_camera_scan_t">扫描</string>
    <string name="tip_camera_scan_b">用相机读取二维码，并从相机、图片剪贴或 PDF 做 OCR。扫描图片时，也可以把裁剪选区存成图片剪贴。</string>
    <string name="tip_settings_lang_t">语言和显示</string>
    <string name="tip_settings_lang_b">切换语言和显示模式（系统、浅色、深色），仅作用于 KlipSilo。</string>
    <string name="tip_settings_pdf_t">PDF 设置</string>
    <string name="tip_settings_pdf_b">设置文本转 PDF 的页边距、字号、行距和最大输出分辨率。</string>
    <string name="tool_limitations">限制</string>
    <string name="limitations_intro">文件转 PDF 会忠实地再现文档——正文、标题、图片、表格和列表标记——但这是简化排版，不是 Word 版式的 1:1 复制。下面是已知的外观限制，以及它们在实际中的含义：</string>
    <string name="limitations_font_t">字体不是文档原来的字体</string>
    <string name="limitations_font_b">文档字体（例如 Arial 或 Calibri）会换成标准字体。正文依然易读，但换行位置可能与 Word 略有不同。</string>
    <string name="limitations_break_t">换行和断词会有差异</string>
    <string name="limitations_break_b">词语不一定在与原文相同的位置断开。没有断词，两端对齐的文本会按左对齐绘制。</string>
    <string name="limitations_spacing_t">段落间距是近似值</string>
    <string name="limitations_spacing_b">段落间距是固定的标准距离，不一定是作者在文档里设置的间距。</string>
    <string name="limitations_tables_t">表格会被简化</string>
    <string name="limitations_tables_b">合并了列或行的单元格（colspan/rowspan）会画成普通单元格。列宽根据内容估算，可能与原文不同。边框是统一的。</string>
    <string name="limitations_headers_t">没有页眉或页脚</string>
    <string name="limitations_headers_b">原文的页眉和页脚（例如页码和文档名）会被省略。</string>
    <string name="limitations_floating_t">浮动元素会并入正文</string>
    <string name="limitations_floating_b">浮动图片和文本框会画进正文流，而不是原来的精确位置，因此文字和图片可能出现在与 Word 不同的地方。最糟的残迹，例如文本框里掉出来的单个字母，会自动滤掉。</string>
    <string name="limitations_lists_t">列表有标记，但没有缩进</string>
    <string name="limitations_lists_b">编号列表和项目符号列表会带上正确的标记（1.、2.、• 等），但没有缩进，看起来像前面多了一个字符的普通段落。</string>
    <string name="limitations_duplicates_t">图片可能会出现多次</string>
    <string name="limitations_duplicates_b">如果原文里同一张图片出现了多次（例如复制的图），PDF 里也会出现多次。这忠实于来源，但可能看起来像出错。</string>
    <string name="limitations_symbols_t">特殊字符可能显示不正确</string>
    <string name="limitations_symbols_b">Wingdings、Symbol 等字体通过一张有限的对照表映射为普通字符。因此少见的特殊字符可能会显示成另一个字符。</string>
    <string name="limitations_summary_t">小结</string>
    <string name="limitations_summary_b">内容——正文、图片和结构——在 PDF 中完全可读，也可以选择和搜索。差异是外观上的：字体、换行、间距和浮动元素的位置接近原文，但并不相同。</string>
